{
  "name": "tap-and-take-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TAP & TAKE API: canteen pre-ordering, token + QR pickup",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed.js --demo",
    "create-admin": "node scripts/createAdmin.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 \"tests/*.test.js\""
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
